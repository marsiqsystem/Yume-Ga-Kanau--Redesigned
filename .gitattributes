# Normalise line endings so a checkout on Windows and on Vercel's Linux
# builders never produce a whole-file diff.
* text=auto eol=lf

# Binary assets: never touch these.
*.webp binary
*.mp4  binary
*.webm binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.jpg  binary
*.jpeg binary
*.png  binary
