# Copy to .env.local for local work, and set the same names in the Vercel
# project (Settings -> Environment Variables) for the live site.
# .env* is gitignored except this file, so real values are never committed.

# The public address of the site. Canonical URLs, Open Graph tags and the
# sitemap are all resolved against this, so it must be the real domain.
NEXT_PUBLIC_SITE_URL=https://yumegakanau.com

# --- Trial-form email (Nodemailer over Gmail SMTP) ---
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT the Gmail
# password. Generate one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be on first). It can be revoked on its own.
GMAIL_USER=yumegakanau22@gmail.com
GMAIL_APP_PASSWORD=
# Where enquiries land. Defaults to GMAIL_USER if left blank.
CONTACT_TO=yumegakanau22@gmail.com

# --- Google Search Console ---
# Paste the token from the "HTML tag" verification method (the content="..."
# value only). Leave blank until you have it.
GOOGLE_SITE_VERIFICATION=

# --- Optional: use a different mail provider ---
# Leave these unset to use Gmail. Set SMTP_HOST/SMTP_PORT to point the same
# route at any other SMTP server instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
